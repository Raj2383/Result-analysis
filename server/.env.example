# Server – copy to .env and adjust
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Postgres – local install (no Docker). Create DB/user first, then match these values.
DATABASE_URL=postgres://resultlens:resultlens@localhost:5432/resultlens
PGHOST=localhost
PGPORT=5432
PGUSER=resultlens
PGPASSWORD=resultlens
PGDATABASE=resultlens

JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=access_token
BCRYPT_ROUNDS=10

# Uploads
MAX_PDF_MB=10

# Seeded accounts (seed script only – never commit real secrets)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
FACULTY_USERNAME=faculty
FACULTY_PASSWORD=Faculty@123
